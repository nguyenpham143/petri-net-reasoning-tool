<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
 <net id="n1" type="http://www.pnml.org/version-2009/grammar/ptnet">
  <page id="pg1">
   <!-- PLACES -->
   <!-- Process 1 -->
   <place id="p1"> <name><text>P1_Ready</text></name> <initialMarking><text>1</text></initialMarking> </place>
   <place id="p2"> <name><text>P1_Has_Res1</text></name> <initialMarking><text>0</text></initialMarking> </place>
   
   <!-- Process 2 -->
   <place id="p3"> <name><text>P2_Ready</text></name> <initialMarking><text>1</text></initialMarking> </place>
   <place id="p4"> <name><text>P2_Has_Res2</text></name> <initialMarking><text>0</text></initialMarking> </place>

   <!-- Resources -->
   <place id="p5"> <name><text>Res_1</text></name> <initialMarking><text>1</text></initialMarking> </place>
   <place id="p6"> <name><text>Res_2</text></name> <initialMarking><text>1</text></initialMarking> </place>

   <!-- TRANSITIONS -->
   <!-- P1: Take R1 -->
   <transition id="t1"> <name><text>P1_Take_R1</text></name> </transition>
   <!-- P1: Take R2 (Deadlock chance) -->
   <transition id="t2"> <name><text>P1_Take_R2</text></name> </transition>

   <!-- P2: Take R2 -->
   <transition id="t3"> <name><text>P2_Take_R2</text></name> </transition>
   <!-- P2: Take R1 (Deadlock chance) -->
   <transition id="t4"> <name><text>P2_Take_R1</text></name> </transition>

   <!-- ARCS -->
   <!-- Flow P1 -->
   <arc id="a1" source="p1" target="t1"/>
   <arc id="a2" source="p5" target="t1"/>
   <arc id="a3" source="t1" target="p2"/>

   <arc id="a4" source="p2" target="t2"/>
   <arc id="a5" source="p6" target="t2"/>
   <arc id="a6" source="t2" target="p1"/>
   <arc id="a7" source="t2" target="p5"/>
   <arc id="a8" source="t2" target="p6"/>

   <!-- Flow P2 -->
   <arc id="a9" source="p3" target="t3"/>
   <arc id="a10" source="p6" target="t3"/>
   <arc id="a11" source="t3" target="p4"/>

   <arc id="a12" source="p4" target="t4"/>
   <arc id="a13" source="p5" target="t4"/>
   <arc id="a14" source="t4" target="p3"/>
   <arc id="a15" source="t4" target="p6"/>
   <arc id="a16" source="t4" target="p5"/>
  </page>
 </net>
</pnml>