<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
 <net id="n1" type="http://www.pnml.org/version-2009/grammar/ptnet">
  <page id="pg1">
   <!-- PLACES -->
   <place id="p0"> <name><text>Start</text></name> <initialMarking><text>1</text></initialMarking> </place>
   
   <!-- Branch A -->
   <place id="p1"> <name><text>A_Step1</text></name> <initialMarking><text>0</text></initialMarking> </place>
   <place id="p2"> <name><text>A_Done</text></name> <initialMarking><text>0</text></initialMarking> </place>

   <!-- Branch B -->
   <place id="p3"> <name><text>B_Step1</text></name> <initialMarking><text>0</text></initialMarking> </place>
   <place id="p4"> <name><text>B_Done</text></name> <initialMarking><text>0</text></initialMarking> </place>

   <place id="p5"> <name><text>End</text></name> <initialMarking><text>0</text></initialMarking> </place>

   <!-- Shared Resource (Mutex) -->
   <place id="p6"> <name><text>Mutex</text></name> <initialMarking><text>1</text></initialMarking> </place>

   <!-- TRANSITIONS -->
   <transition id="t0"> <name><text>Fork</text></name> </transition>

   <!-- Branch A Actions -->
   <transition id="t1"> <name><text>A_Work</text></name> </transition>
   <transition id="t2"> <name><text>A_Finish</text></name> </transition>

   <!-- Branch B Actions -->
   <transition id="t3"> <name><text>B_Work</text></name> </transition>
   <transition id="t4"> <name><text>B_Finish</text></name> </transition>

   <transition id="t5"> <name><text>Join</text></name> </transition>
   <transition id="t6"> <name><text>Reset</text></name> </transition>

   <!-- ARCS -->
   <!-- Fork -->
   <arc id="a1" source="p0" target="t0"/>
   <arc id="a2" source="t0" target="p1"/>
   <arc id="a3" source="t0" target="p3"/>

   <!-- Branch A -->
   <arc id="a4" source="p1" target="t1"/>
   <arc id="a5" source="p6" target="t1"/> <!-- Lock Mutex -->
   <arc id="a6" source="t1" target="p2"/>
   <arc id="a7" source="t1" target="p6"/> <!-- Unlock Mutex -->
   
   <!-- Branch B -->
   <arc id="a8" source="p3" target="t3"/>
   <arc id="a9" source="p6" target="t3"/> <!-- Lock Mutex -->
   <arc id="a10" source="t3" target="p4"/>
   <arc id="a11" source="t3" target="p6"/> <!-- Unlock Mutex -->

   <!-- Join -->
   <arc id="a12" source="p2" target="t5"/>
   <arc id="a13" source="p4" target="t5"/>
   <arc id="a14" source="t5" target="p5"/>

   <!-- Reset -->
   <arc id="a15" source="p5" target="t6"/>
   <arc id="a16" source="t6" target="p0"/>

  </page>
 </net>
</pnml>